# Copia este archivo a secrets.env y pide los valores reales al administrador.
# cp secrets.env.example secrets.env
#
# Necesitas pedir: WS_USER, WS_PASS (y confirmar WS_BASE si cambia).

# Credenciales Wansoft (necesarias para "Descargar de Wansoft" en la app)
WS_BASE=https://www.wansoft.net/Wansoft.Web
WS_USER=tu_usuario_aqui
WS_PASS=tu_contraseña_aqui
